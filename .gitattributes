# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
*.sqlite3 filter=lfs diff=lfs merge=lfs -text

# Chroma's persisted HNSW segment files (data/chroma/<segment-uuid>/)
data/chroma/**/*.bin filter=lfs diff=lfs merge=lfs -text
data/chroma/**/*.pickle filter=lfs diff=lfs merge=lfs -text
