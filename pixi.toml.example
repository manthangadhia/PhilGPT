# Copy these dependencies to your own pixi.toml to have the same, minimal environment configuration as Manthan

[dependencies]
python = "3.11.14.*"
pip = ">=26.1.1,<27"
numpy = ">=2.4.3,<3"
nomkl = ">=1.0,<2"

[pypi-dependencies]
chromadb = ">=1.5.9, <2"
requests = ">=2.34.0, <3"
beautifulsoup4 = ">=4.14.3, <5"
lxml = ">=6.1.0, <7"
nltk = ">=3.9.4, <4"
google-genai = ">=2.0.1, <3"
python-dotenv = ">=1.2.2, <2"
torch = { version = ">=2.5.1", index = "https://download.pytorch.org/whl/cpu" }
sentence-transformers = ">=5.4.1, <6"
